  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
