{
  "name": "mcp-gateway",
  "version": "0.16.0",
  "description": "Corpo Valley MCP gateway: OAuth-authenticating reverse proxy in front of per-project MCP endpoints",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
